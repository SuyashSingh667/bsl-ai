# BSL AI Safety Intelligence Platform — Environment Configuration Template

# Operational Deployment Mode: 'local_airgapped' (100% on-premise, zero internet), 'local_llm', or 'cloud_llm'
BSL_INFERENCE_MODE=local_airgapped

# Default Tenant Plant ID (e.g. 'bsl_bokaro', 'rsp_rourkela')
BSL_DEFAULT_PLANT_ID=bsl_bokaro

# Data Retention Window in Days (expired audio/photos are automatically pruned)
BSL_DATA_RETENTION_DAYS=180

# Outbound Dispatch Webhook URL (for Control Room SCADA / DCS integration)
BSL_DISPATCH_WEBHOOK_URL=http://controlroom.bokaro.internal:9090/safety-webhook
BSL_WEBHOOK_SECRET=bsl-production-safety-secret-key-2026

# Speech Recognition Configuration
WHISPER_MODEL_SIZE=small

# Local On-Prem LLM Configuration (Used only if BSL_INFERENCE_MODE=local_llm)
BSL_LOCAL_LLM_URL=http://127.0.0.1:11434/api/generate
BSL_LOCAL_MODEL_NAME=llama3.2:3b

# Backend Port & Host
PORT=8000
HOST=0.0.0.0
